#!/usr/bin/env bash
# Unified FELIXla command-line entrypoint.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  felixla [input flags] [action flags] [output/filter flags]

PLINK-style examples:
  felixla --phase-vcf genotype.phased.vcf.gz \
          --flare-vcf flare.anc.vcf.gz \
          --n-ancestries 5 \
          --make-felixla \
          --out hybrid/chr22

  felixla --felixla hybrid/chr22 \
          --query chr22:160500 \
          --ref A \
          --alt G \
          --nonzero-only

  felixla --felixla hybrid/chr22 --export vcf --out hybrid/chr22.roundtrip

Primary input flags:
  --phase-vcf PATH              Phased diploid genotype VCF/BCF.
  --flare-vcf PATH              FLARE local ancestry VCF/BCF with AN1/AN2.
  --rfmix-msp PATH              RFMix MSP file.
  --tractor-dosage-vcf PATH     TRACTOR dosage VCF/BCF with ANC#/DS# fields.
  --felixla PREFIX              Existing FELIXla/tractor_hybrid prefix.
  --vcf PATH                    VCF input for --admixture; may be repeated.

Action flags:
  --make-felixla                Create a FELIXla prefix from inputs, or extract from --felixla.
  --export vcf                  Export --felixla prefix to split-biallelic phased VCF.
  --query [CHR:POS]             Query DSALL and ancestry-specific DS1..DSk.
  --admixture                   Estimate per-sample global ancestry proportions.
  --compare-vcfs A B            Compare two VCFs.
  --shapeit-args                Build converter argument rows from SHAPEIT/GLIMPSE chunks.
  --recommend-mac-threshold     Print ceil(n_samples / 32).

Common output and parameter flags:
  --out PATH                    Output prefix or report path, depending on action.
  --n-ancestries INT            Number of ancestry labels.
  --mac-threshold INT           Sparse/dense MAC threshold. Default: auto.
  --n-samples INT               Sample count for threshold helpers and template-only jobs.
  --keep FILE                   Sample IDs to retain, one ID per line.
  --extract FILE                PVAR/VCF allele list to retain by CHROM/POS/REF/ALT.
  --region CHR:START-END        Region for conversion/extraction.
  --chr CHR --from-bp N --to-bp N
                               PLINK-like region form for extraction.
  --bp N                        Position for --query with --chr.
  --ref ALLELE --alt ALLELE     Disambiguate split-biallelic query target.
  --global-index N              Query by split variant global index.
  --nonzero-only                For --query, emit only samples with nonzero DSALL.

Compatibility mode:
  felixla from-flare ...        Equivalent to flare_subset_to_tractor_hybrid ...
  felixla from-rfmix ...        Equivalent to rfmix_msp_to_tractor_hybrid ...
  felixla from-tractor-dosage ...
  felixla to-vcf ...
  felixla extract ...
  felixla query ...
  felixla admixture ...
  felixla compare-vcfs ...
  felixla shapeit-args ...
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

resolve_tool() {
  local name="$1"
  local candidate
  for candidate in \
    "$script_dir/$name" \
    "$repo_root/bin/$name" \
    "$repo_root/bin-static/$name" \
    "$repo_root/prebuilt/linux-x86_64-static/$name"; do
    if [[ -x "$candidate" && "$candidate" != "${BASH_SOURCE[0]}" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi

  return 1
}

run_tool() {
  local name="$1"
  shift
  local tool
  tool="$(resolve_tool "$name")" || die "cannot find required tool: $name"
  exec "$tool" "$@"
}

run_tool_stdout() {
  local out_path="$1"
  shift
  local name="$1"
  shift
  local tool
  tool="$(resolve_tool "$name")" || die "cannot find required tool: $name"
  if [[ -n "$out_path" ]]; then
    "$tool" "$@" >"$out_path"
    exit $?
  fi
  exec "$tool" "$@"
}

run_shapeit_args_compat() {
  local candidate
  for candidate in \
    "$script_dir/shapeit_chunks_to_tractor_args" \
    "$script_dir/shapeit_chunks_to_tractor_args.sh" \
    "$repo_root/scripts/shapeit_chunks_to_tractor_args.sh"; do
    if [[ -x "$candidate" || -f "$candidate" ]]; then
      exec bash "$candidate" "$@"
    fi
  done

  if command -v shapeit_chunks_to_tractor_args >/dev/null 2>&1; then
    exec shapeit_chunks_to_tractor_args "$@"
  fi
  if command -v shapeit_chunks_to_tractor_args.sh >/dev/null 2>&1; then
    exec shapeit_chunks_to_tractor_args.sh "$@"
  fi

  die "cannot find shapeit_chunks_to_tractor_args"
}

run_shapeit_args_stdout() {
  local out_path="$1"
  shift
  local candidate
  for candidate in \
    "$script_dir/shapeit_chunks_to_tractor_args" \
    "$script_dir/shapeit_chunks_to_tractor_args.sh" \
    "$repo_root/scripts/shapeit_chunks_to_tractor_args.sh"; do
    if [[ -x "$candidate" || -f "$candidate" ]]; then
      if [[ -n "$out_path" ]]; then
        bash "$candidate" "$@" >"$out_path"
        exit $?
      fi
      exec bash "$candidate" "$@"
    fi
  done
  die "cannot find shapeit_chunks_to_tractor_args"
}

run_mac_threshold() {
  local n_samples=""

  if (($# == 1)) && [[ "$1" =~ ^[0-9]+$ ]]; then
    n_samples="$1"
  else
    while (($#)); do
      case "$1" in
        -h|--help)
          cat <<'EOF'
Usage:
  felixla --recommend-mac-threshold --n-samples N_SAMPLES
  felixla mac-threshold N_SAMPLES

Storage break-even threshold:
  mac_threshold = ceil(n_samples / 32)
EOF
          exit 0
          ;;
        -n|--n-samples)
          (($# >= 2)) || die "$1 requires a value"
          n_samples="$2"
          shift 2
          ;;
        *)
          die "unknown mac-threshold argument: $1"
          ;;
      esac
    done
  fi

  [[ "$n_samples" =~ ^[0-9]+$ ]] || die "n_samples must be a non-negative integer"
  ((n_samples > 0)) || die "n_samples must be positive"
  local threshold=$(((n_samples + 31) / 32))
  printf 'n_samples\t%s\n' "$n_samples"
  printf 'recommended_mac_threshold\t%s\n' "$threshold"
}

compute_mac_threshold() {
  local samples="$1"
  [[ "$samples" =~ ^[0-9]+$ ]] || die "n_samples must be a non-negative integer"
  ((samples > 0)) || die "n_samples must be positive"
  printf '%s\n' $(((samples + 31) / 32))
}

vcf_export_path() {
  local out="$1"
  case "$out" in
    *.vcf|*.vcf.gz|*.vcf.bgz)
      printf '%s\n' "$out"
      ;;
    *)
      printf '%s.vcf.gz\n' "$out"
      ;;
  esac
}

split_region() {
  local region="$1"
  local chr start end rest
  [[ "$region" == *:* && "$region" == *-* ]] || die "region must look like CHR:START-END: $region"
  chr="${region%%:*}"
  rest="${region#*:}"
  start="${rest%%-*}"
  end="${rest#*-}"
  [[ -n "$chr" && "$start" =~ ^[0-9]+$ && "$end" =~ ^[0-9]+$ ]] ||
    die "region must look like CHR:START-END: $region"
  printf '%s\t%s\t%s\n' "$chr" "$start" "$end"
}

run_plink_style() {
  local phase_vcf="" flare_vcf="" rfmix_msp="" tractor_dosage_vcf=""
  local felixla_prefix="" out_path="" n_ancestries="" mac_threshold=""
  local region="" chr="" from_bp="" to_bp="" bp="" ref="" alt="" global_index=""
  local export_format="" query_target="" n_samples=""
  local keep_path="" extract_path=""
  local make_felixla=0 query_action=0 admixture_action=0 shapeit_action=0
  local compare_action=0 recommend_action=0 nonzero_only=0 split_multiallelic=0
  local max_diffs="" pattern="" chroms="" anc_fields="" progress_every="" thin=""
  local chunks_dir="" phase_template="" flare_template="" out_prefix_template=""
  local region_column="" chrom_style="" chunk_width="" header=0
  local vcfs=() compare_paths=() chunks=()

  while (($#)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --version)
        printf 'FELIXla CLI v0, tractor_hybrid-compatible layout format_version=1\n'
        exit 0
        ;;
      --phase-vcf|--genotype-vcf)
        (($# >= 2)) || die "$1 requires a value"
        phase_vcf="$2"
        shift 2
        ;;
      --flare-vcf|--lai-vcf)
        (($# >= 2)) || die "$1 requires a value"
        flare_vcf="$2"
        shift 2
        ;;
      --rfmix-msp)
        (($# >= 2)) || die "$1 requires a value"
        rfmix_msp="$2"
        shift 2
        ;;
      --tractor-dosage-vcf)
        (($# >= 2)) || die "$1 requires a value"
        tractor_dosage_vcf="$2"
        shift 2
        ;;
      --felixla|--tractor-hybrid)
        (($# >= 2)) || die "$1 requires a value"
        felixla_prefix="$2"
        shift 2
        ;;
      --vcf)
        (($# >= 2)) || die "$1 requires a value"
        vcfs+=("$2")
        shift 2
        ;;
      --make-felixla|--make-tractor-hybrid)
        make_felixla=1
        shift
        ;;
      --export)
        (($# >= 2)) || die "--export requires vcf"
        export_format="$2"
        shift 2
        ;;
      --query)
        query_action=1
        if (($# >= 2)) && [[ "$2" != --* ]]; then
          query_target="$2"
          shift 2
        else
          shift
        fi
        ;;
      --admixture)
        admixture_action=1
        shift
        ;;
      --shapeit-args)
        shapeit_action=1
        shift
        ;;
      --compare-vcfs)
        (($# >= 3)) || die "--compare-vcfs requires two VCF paths"
        compare_action=1
        compare_paths=("$2" "$3")
        shift 3
        ;;
      --recommend-mac-threshold|--choose-mac-threshold)
        recommend_action=1
        shift
        ;;
      --out)
        (($# >= 2)) || die "--out requires a value"
        out_path="$2"
        shift 2
        ;;
      --n-ancestries|--n-ancestry|--ancestries)
        (($# >= 2)) || die "$1 requires a value"
        n_ancestries="$2"
        shift 2
        ;;
      --mac-threshold)
        (($# >= 2)) || die "--mac-threshold requires a value"
        mac_threshold="$2"
        shift 2
        ;;
      --n-samples)
        (($# >= 2)) || die "--n-samples requires a value"
        n_samples="$2"
        shift 2
        ;;
      --keep)
        (($# >= 2)) || die "--keep requires a value"
        keep_path="$2"
        shift 2
        ;;
      --extract)
        (($# >= 2)) || die "--extract requires a value"
        extract_path="$2"
        shift 2
        ;;
      --region)
        (($# >= 2)) || die "--region requires a value"
        region="$2"
        shift 2
        ;;
      --chr)
        (($# >= 2)) || die "--chr requires a value"
        chr="$2"
        shift 2
        ;;
      --from-bp)
        (($# >= 2)) || die "--from-bp requires a value"
        from_bp="$2"
        shift 2
        ;;
      --to-bp)
        (($# >= 2)) || die "--to-bp requires a value"
        to_bp="$2"
        shift 2
        ;;
      --bp)
        (($# >= 2)) || die "--bp requires a value"
        bp="$2"
        shift 2
        ;;
      --ref)
        (($# >= 2)) || die "--ref requires a value"
        ref="$2"
        shift 2
        ;;
      --alt)
        (($# >= 2)) || die "--alt requires a value"
        alt="$2"
        shift 2
        ;;
      --global-index)
        (($# >= 2)) || die "--global-index requires a value"
        global_index="$2"
        query_action=1
        shift 2
        ;;
      --nonzero-only)
        nonzero_only=1
        shift
        ;;
      --pattern)
        (($# >= 2)) || die "--pattern requires a value"
        pattern="$2"
        shift 2
        ;;
      --chroms)
        (($# >= 2)) || die "--chroms requires a value"
        chroms="$2"
        shift 2
        ;;
      --anc-fields)
        (($# >= 2)) || die "--anc-fields requires a value"
        anc_fields="$2"
        shift 2
        ;;
      --progress-every)
        (($# >= 2)) || die "--progress-every requires a value"
        progress_every="$2"
        shift 2
        ;;
      --thin)
        (($# >= 2)) || die "--thin requires a value"
        thin="$2"
        shift 2
        ;;
      --split-multiallelic)
        split_multiallelic=1
        shift
        ;;
      --max-diffs)
        (($# >= 2)) || die "--max-diffs requires a value"
        max_diffs="$2"
        shift 2
        ;;
      --chunks)
        (($# >= 2)) || die "--chunks requires a value"
        chunks+=("$2")
        shift 2
        ;;
      --chunks-dir)
        (($# >= 2)) || die "--chunks-dir requires a value"
        chunks_dir="$2"
        shift 2
        ;;
      --phase-template)
        (($# >= 2)) || die "--phase-template requires a value"
        phase_template="$2"
        shift 2
        ;;
      --flare-template)
        (($# >= 2)) || die "--flare-template requires a value"
        flare_template="$2"
        shift 2
        ;;
      --out-prefix-template)
        (($# >= 2)) || die "--out-prefix-template requires a value"
        out_prefix_template="$2"
        shift 2
        ;;
      --region-column)
        (($# >= 2)) || die "--region-column requires a value"
        region_column="$2"
        shift 2
        ;;
      --chrom-style)
        (($# >= 2)) || die "--chrom-style requires a value"
        chrom_style="$2"
        shift 2
        ;;
      --chunk-width)
        (($# >= 2)) || die "--chunk-width requires a value"
        chunk_width="$2"
        shift 2
        ;;
      --header)
        header=1
        shift
        ;;
      *)
        die "unknown FELIXla flag: $1"
        ;;
    esac
  done

  if [[ -n "$keep_path" || -n "$extract_path" ]]; then
    if ! ((make_felixla)) ||
       ((query_action || admixture_action || shapeit_action || compare_action || recommend_action)) ||
       [[ -n "$export_format" || -z "$phase_vcf" || -z "$flare_vcf" ]]; then
      die "--keep/--extract are currently supported only for --phase-vcf + --flare-vcf --make-felixla"
    fi
  fi

  if ((recommend_action)); then
    [[ -n "$n_samples" ]] || die "--recommend-mac-threshold requires --n-samples"
    run_mac_threshold --n-samples "$n_samples"
    exit 0
  fi

  if ((shapeit_action)); then
    if [[ -z "$mac_threshold" && -n "$n_samples" ]]; then
      mac_threshold="$(compute_mac_threshold "$n_samples")"
      printf 'FELIXla: --mac-threshold not supplied; using %s = ceil(%s / 32) from --n-samples.\n' \
        "$mac_threshold" "$n_samples" >&2
    fi
    [[ -n "$mac_threshold" ]] || die "--shapeit-args requires --mac-threshold or --n-samples"
    local shapeit_args=()
    for chunk in "${chunks[@]}"; do
      shapeit_args+=(--chunks "$chunk")
    done
    [[ -n "$chunks_dir" ]] && shapeit_args+=(--chunks-dir "$chunks_dir")
    [[ -n "$phase_template" ]] && shapeit_args+=(--phase-template "$phase_template")
    [[ -n "$flare_template" ]] && shapeit_args+=(--flare-template "$flare_template")
    [[ -n "$out_prefix_template" ]] && shapeit_args+=(--out-prefix-template "$out_prefix_template")
    [[ -n "$n_ancestries" ]] && shapeit_args+=(--n-ancestries "$n_ancestries")
    [[ -n "$mac_threshold" ]] && shapeit_args+=(--mac-threshold "$mac_threshold")
    [[ -n "$region_column" ]] && shapeit_args+=(--region-column "$region_column")
    [[ -n "$chrom_style" ]] && shapeit_args+=(--chrom-style "$chrom_style")
    [[ -n "$chunk_width" ]] && shapeit_args+=(--chunk-width "$chunk_width")
    ((header)) && shapeit_args+=(--header)
    run_shapeit_args_stdout "$out_path" "${shapeit_args[@]}"
  fi

  if ((compare_action)); then
    local compare_args=("${compare_paths[@]}")
    ((split_multiallelic)) && compare_args+=(--split-multiallelic)
    [[ -n "$max_diffs" ]] && compare_args+=(--max-diffs "$max_diffs")
    run_tool_stdout "$out_path" compare_vcfs "${compare_args[@]}"
  fi

  if ((admixture_action)); then
    local admix_args=("${vcfs[@]}")
    [[ -n "$pattern" ]] && admix_args+=(--pattern "$pattern")
    [[ -n "$chroms" ]] && admix_args+=(--chroms "$chroms")
    [[ -n "$anc_fields" ]] && admix_args+=(--anc-fields "$anc_fields")
    [[ -n "$progress_every" ]] && admix_args+=(--progress-every "$progress_every")
    [[ -n "$thin" ]] && admix_args+=(--thin "$thin")
    [[ -n "$out_path" ]] && admix_args+=(--output "$out_path")
    run_tool calc_tractor_admixture "${admix_args[@]}"
  fi

  if ((make_felixla)); then
    [[ -n "$out_path" ]] || die "--make-felixla requires --out"
    if [[ -n "$phase_vcf" && -n "$flare_vcf" ]]; then
      [[ -n "$n_ancestries" ]] || die "from-FLARE writing requires --n-ancestries"
      [[ -n "$mac_threshold" ]] || mac_threshold="auto"
      local args=("$phase_vcf" "$flare_vcf" "$n_ancestries" "$mac_threshold" "$out_path")
      [[ -n "$region" ]] && args+=("$region")
      [[ -n "$keep_path" ]] && args+=(--keep "$keep_path")
      [[ -n "$extract_path" ]] && args+=(--extract "$extract_path")
      run_tool flare_subset_to_tractor_hybrid "${args[@]}"
    fi
    if [[ -n "$phase_vcf" && -n "$rfmix_msp" ]]; then
      [[ -z "$region" ]] || die "--region is not supported for --rfmix-msp conversion"
      [[ -z "$keep_path" && -z "$extract_path" ]] ||
        die "--keep/--extract are currently supported for --phase-vcf + --flare-vcf writing"
      [[ -n "$n_ancestries" ]] || die "from-RFMix writing requires --n-ancestries"
      [[ -n "$mac_threshold" ]] || mac_threshold="auto"
      run_tool rfmix_msp_to_tractor_hybrid "$phase_vcf" "$rfmix_msp" "$n_ancestries" "$mac_threshold" "$out_path"
    fi
    if [[ -n "$tractor_dosage_vcf" ]]; then
      [[ -z "$keep_path" && -z "$extract_path" ]] ||
        die "--keep/--extract are currently supported for --phase-vcf + --flare-vcf writing"
      [[ -n "$n_ancestries" ]] || die "from-TRACTOR-dosage writing requires --n-ancestries"
      [[ -n "$mac_threshold" ]] || mac_threshold="auto"
      run_tool tractor_dosage_vcf_to_hybrid "$tractor_dosage_vcf" "$n_ancestries" "$mac_threshold" "$out_path"
    fi
    if [[ -n "$felixla_prefix" ]]; then
      [[ -z "$keep_path" && -z "$extract_path" ]] ||
        die "--keep/--extract are currently supported for --phase-vcf + --flare-vcf writing"
      if [[ -n "$region" ]]; then
        run_tool tractor_hybrid_extract_region "$felixla_prefix" "$region" "$out_path"
      fi
      [[ -n "$chr" && -n "$from_bp" && -n "$to_bp" ]] ||
        die "extracting from --felixla requires --region or --chr/--from-bp/--to-bp"
      run_tool tractor_hybrid_extract_region "$felixla_prefix" "$chr" "$from_bp" "$to_bp" "$out_path"
    fi
    die "--make-felixla needs one input source: --phase-vcf + --flare-vcf, --phase-vcf + --rfmix-msp, --tractor-dosage-vcf, or --felixla"
  fi

  if [[ -n "$export_format" ]]; then
    [[ "$export_format" == "vcf" ]] || die "only --export vcf is currently supported"
    [[ -n "$felixla_prefix" ]] || die "--export vcf requires --felixla PREFIX"
    [[ -n "$out_path" ]] || die "--export vcf requires --out"
    run_tool tractor_hybrid_to_vcf "$felixla_prefix" "$(vcf_export_path "$out_path")"
  fi

  if ((query_action)); then
    [[ -n "$felixla_prefix" ]] || die "--query requires --felixla PREFIX"
    local query_args=("$felixla_prefix")
    if [[ -n "$global_index" ]]; then
      query_args+=(--global-index "$global_index")
    elif [[ -n "$query_target" ]]; then
      query_args+=("$query_target")
    elif [[ -n "$chr" && -n "$bp" ]]; then
      query_args+=("$chr" "$bp")
    else
      die "--query requires CHR:POS, --chr/--bp, or --global-index"
    fi
    if [[ -n "$ref" || -n "$alt" ]]; then
      [[ -n "$ref" && -n "$alt" ]] || die "--ref and --alt must be supplied together"
      query_args+=("$ref" "$alt")
    fi
    ((nonzero_only)) && query_args+=(--nonzero-only)
    run_tool_stdout "$out_path" felixla_query "${query_args[@]}"
  fi

  usage >&2
  die "no action flag supplied"
}

run_compat_command() {
  local cmd="$1"
  shift
  case "$cmd" in
    -h|--help|help)
      usage
      ;;
    --version|version)
      printf 'FELIXla CLI v0, tractor_hybrid-compatible layout format_version=1\n'
      ;;
    from-flare|build-flare|pack-flare|flare|flare_subset_to_tractor_hybrid)
      run_tool flare_subset_to_tractor_hybrid "$@"
      ;;
    from-rfmix|rfmix|rfmix-msp|rfmix_msp_to_tractor_hybrid)
      run_tool rfmix_msp_to_tractor_hybrid "$@"
      ;;
    from-tractor-dosage|from-dosage|tractor-dosage|dosage|tractor_dosage_vcf_to_hybrid)
      run_tool tractor_dosage_vcf_to_hybrid "$@"
      ;;
    to-vcf|export-vcf|vcf|tractor_hybrid_to_vcf)
      run_tool tractor_hybrid_to_vcf "$@"
      ;;
    extract|extract-region|region|tractor_hybrid_extract_region)
      run_tool tractor_hybrid_extract_region "$@"
      ;;
    query|dosage-query|felixla_query)
      run_tool felixla_query "$@"
      ;;
    admixture|calc-admixture|global-ancestry|calc_tractor_admixture)
      run_tool calc_tractor_admixture "$@"
      ;;
    compare|compare-vcfs|compare_vcfs)
      run_tool compare_vcfs "$@"
      ;;
    shapeit-args|shapeit_chunks_to_tractor_args|shapeit_chunks_to_tractor_args.sh)
      run_shapeit_args_compat "$@"
      ;;
    mac-threshold|choose-mac-threshold)
      run_mac_threshold "$@"
      ;;
    *)
      usage >&2
      die "unknown FELIXla command: $cmd"
      ;;
  esac
}

if (($# == 0)); then
  usage >&2
  exit 2
fi

case "$1" in
  --*)
    run_plink_style "$@"
    ;;
  *)
    cmd="$1"
    shift
    run_compat_command "$cmd" "$@"
    ;;
esac
